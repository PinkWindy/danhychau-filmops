# Sao chép thành .env (không commit .env) hoặc đặt tương đương trên Render → Environment.

# --- Database ---
# Để trống = SQLite file mặc định: web_demo/warehouse_demo.db
# Production (Render): dán Internal Database URL của PostgreSQL
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# --- Seed khi khởi động (chỉ khi DB trống: chưa có dealer) ---
# SQLite: mặc định CÓ thể seed bộ demo chuẩn nếu DB trống.
# PostgreSQL: mặc định KHÔNG seed — dữ liệu do bạn nhập / populate_db / import.
# DYC_STARTUP_SEED_DEMO=true
# DYC_STARTUP_SEED_DEMO=false

# --- Reset API (chỉ SQLite) — không bật trên production thật ---
# ALLOW_DB_RESET=true
# ADMIN_RESET_TOKEN=đổi_thành_chuỗi_bí_mật_dài
